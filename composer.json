{
    "name": "bale/api",
    "description": "API Management for Bale (tokens, endpoints, permissions per endpoint)",
    "keywords": [
        "bale",
        "laravel",
        "api"
    ],
    "homepage": "https://github.com/bale/api",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricky R",
            "email": "ricky.romdhoni@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-activitylog": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bale\\Api\\": "src/",
            "Bale\\Api\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bale\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bale\\Api\\ApiServiceProvider"
            ],
            "aliases": {
                "Api": "Bale\\Api\\Facades\\Api"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}